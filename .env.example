# Copy this file to .env and fill in the key.
# Every value below is optional except OPENROUTER_API_KEY.

# ----- Brain (the LLM) --------------------------------------------------
# openrouter = Gemini through OpenRouter. fake = canned answers, no API call
# (used by the tests, and handy when you have no internet).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=google/gemini-2.5-flash
# Tried in order when the main model fails before it says anything
# (402 no credits, 429 busy, 5xx). A failed model is skipped for a while
# (10 minutes after a 402). ":free" models work with zero credits, about
# 50 requests a day in total.
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,openrouter/free
# off = no hidden "thinking" before the answer (fastest). Or: low, medium, high.
LLM_REASONING=off
# Any OpenAI-compatible server works here. Two useful ones:
#   Google AI Studio (free Gemini tier, key from aistudio.google.com):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-2.5-flash
#     GEMINI_API_KEY=...
#     LLM_FALLBACK_MODELS=
#   A local llama.cpp server (no key, fully offline):
#     LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Sampling. Low temperature = focused answers. Top-p cuts unlikely tokens.
LLM_TEMPERATURE=0.4
LLM_TOP_P=0.95
# Hard cap on answer length. About 60 words fits in 120 tokens.
LLM_MAX_TOKENS=220
LLM_TIMEOUT_MS=30000

# ----- About you --------------------------------------------------------
# Topics you talk about. Speech recognition often mishears rare terms
# ("KB cache" for "KV cache"). This line lets the model fix them.
USER_CONTEXT=They are preparing for GenAI interviews. Common topics: LLMs, tokens, context window, temperature, top-p, KV cache, quantization, GGUF, RAG, embeddings, streaming, latency, speech recognition, text to speech.

# ----- Memory (context window) -----------------------------------------
# How many past question and answer pairs are sent with each question.
HISTORY_TURNS=6
# Rough token cap for that history (1 token is about 4 characters).
HISTORY_TOKEN_BUDGET=1500

# ----- Notes (RAG) -----------------------------------------------------
NOTES_ENABLED=true
NOTES_DIR=notes
NOTES_TOP_K=3
# Chunks scoring below this are not added to the prompt (0 to 1).
NOTES_MIN_SCORE=0.2
NOTES_CHUNK_CHARS=600

# ----- Server ----------------------------------------------------------
# The brain only listens on 127.0.0.1, so nobody else on the network can
# spend your quota.
BRAIN_PORT=47800
